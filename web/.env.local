# Copy to `.env.local` and fill in. This file is the website's own env — it is
# deliberately NOT shared with the mobile app or the API server.
#
# Only NEXT_PUBLIC_* vars are readable in the browser. Never put a secret here:
# this is a static site, so every value below ships to the visitor.

# Canonical site URL. Used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://pricedug.com

# Clerk publishable key for LOCAL development. This must be the Clerk
# *development* instance key (pk_test_...), from dashboard.clerk.com -> API Keys.
# A production key (pk_live_...) is rejected by Clerk on any host other than
# pricedug.com, so it belongs in the deployed host's env, never here.
# Left empty, the site builds and runs with accounts switched off.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z2VudWluZS1iaXNvbi01Ni5jbGVyay5hY2NvdW50cy5kZXYk

# Supabase (browser-safe: the anon key is public by design and every table is
# protected by RLS). Same project as the mobile app.
NEXT_PUBLIC_SUPABASE_URL=https://nirodctxmpvswrjyvlqq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5pcm9kY3R4bXB2c3dyanl2bHFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM0ODcyMTksImV4cCI6MjA5OTA2MzIxOX0.k4REAWvuDlh1cKBZfVnAA9pDlHgx_IoaklgXsVQHdCI
