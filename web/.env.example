# Copy to `.env.local` and fill in. This file is the website's own env — it is
# deliberately NOT shared with the mobile app or the API server.
#
# Only NEXT_PUBLIC_* vars are readable in the browser. Never put a secret here:
# this is a static site, so every value below ships to the visitor.

# Canonical site URL. Used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://pricedug.com

# Clerk publishable key for the website (browser-safe, same Clerk instance as
# the mobile app). Without it the auth pages report a misconfiguration and the
# marketing pages still render.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase project (browser-safe anon key; RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
