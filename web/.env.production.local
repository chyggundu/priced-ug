# Production build env for the website — used by `next build`, never by `next dev`.
#
# Next.js precedence (highest first):
#   .env.production.local  ← this file, only when NODE_ENV=production (next build)
#   .env.local             ← the development key, used by next dev
#   .env.production
#   .env
#
# So the live key below is what ships in the exported site, while local
# development keeps using the pk_test key in .env.local. Both files are
# gitignored (.gitignore covers `.env.local` and `.env.*.local`).
#
# Only the PUBLISHABLE key belongs here. This site is a static export: every
# value in this file is compiled into JavaScript that visitors download, so a
# Clerk secret key must never appear in it.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsucHJpY2VkdWcuY29tJA

# Supabase is the same project in both environments (RLS does the enforcing).
NEXT_PUBLIC_SUPABASE_URL=https://nirodctxmpvswrjyvlqq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5pcm9kY3R4bXB2c3dyanl2bHFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM0ODcyMTksImV4cCI6MjA5OTA2MzIxOX0.k4REAWvuDlh1cKBZfVnAA9pDlHgx_IoaklgXsVQHdCI

