modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Mobile"

# Two independent apps; neither has a server of its own. Data comes straight
# from Supabase, so nothing needs a Postgres module or a backend process here.

[[workflows.workflow]]
name = "Mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/pricedug && pnpm install --ignore-workspace && pnpm exec expo start"

[[workflows.workflow]]
name = "Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web && pnpm install --ignore-workspace && pnpm run dev"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
channel = "stable-25_05"
