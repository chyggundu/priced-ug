# ─── Database ────────────────────────────────────────────────────────────────
# Your PostgreSQL connection string (local or cloud)
DATABASE_URL=postgresql://user:password@localhost:5432/pricedug

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# ─── Admin ───────────────────────────────────────────────────────────────────
# Your own Clerk user ID — find it in Clerk dashboard → Users
ADMIN_USER_ID=user_REPLACE_ME

# ─── Optional ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
