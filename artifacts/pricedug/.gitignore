# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# The android/ and ios/ projects are tracked, so versions and native tweaks live
# in git. Their build output must not be: android/app/build alone is ~2.3 GB and
# ios/Pods ~925 MB, all of it regenerated by a build.
android/.gradle/
android/.idea/
android/.cxx/
android/build/
android/app/build/
android/app/release/
android/app/debug/
android/local.properties
android/*.iml
android/.kotlin/

ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
ios/**/xcuserdata/
ios/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

# Tracked on purpose: this file holds only EXPO_PUBLIC_* values, which are
# compiled into the app binary and readable by anyone who downloads it. The
# negation is needed because the repo-root .gitignore also excludes `.env`.
!.env

# Google Play service account key (sensitive — never commit)
google-service-account.json
