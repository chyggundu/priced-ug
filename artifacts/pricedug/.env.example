# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Same publishable key from https://dashboard.clerk.com → your app → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── Admin ───────────────────────────────────────────────────────────────────
# Your own Clerk user ID — same value as ADMIN_USER_ID in the API server .env
EXPO_PUBLIC_ADMIN_USER_ID=user_REPLACE_ME

# ─── API Server ──────────────────────────────────────────────────────────────
# Where your API server is running locally (no trailing slash)
EXPO_PUBLIC_DOMAIN=http://localhost:8080

# Clerk auth proxy — points to your local API server's Clerk proxy route
EXPO_PUBLIC_CLERK_PROXY_URL=http://localhost:8080/api/__clerk
