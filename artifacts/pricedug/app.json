{
  "expo": {
    "name": "Priced Ug",
    "slug": "pricedug",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pricedug",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pricedug.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Priced Ug to use your location to pin your business on the map.",
        "NSPhotoLibraryUsageDescription": "Allow Priced Ug to access your photos to upload product and business images and videos.",
        "NSCameraUsageDescription": "Allow Priced Ug to use your camera to take product and business photos and videos.",
        "NSMicrophoneUsageDescription": "Allow Priced Ug to use your microphone to record audio for product videos."
      }
    },
    "android": {
      "package": "com.pricedug.mobile",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Priced Ug to use your location to pin your business on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Priced Ug to access your photos to upload product and business images and videos.",
          "cameraPermission": "Allow Priced Ug to use your camera to take product and business photos and videos.",
          "microphonePermission": "Allow Priced Ug to use your microphone to record audio for product videos."
        }
      ],
      "expo-video",
      "@clerk/expo",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "157407249642-g0i3nojfcv2puck6vs4qmad38gu6oemv.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID": "157407249642-lu1ej8o8aluse2191kcqkvsg4fj74tof.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.157407249642-lu1ej8o8aluse2191kcqkvsg4fj74tof"
    }
  }
}
